FRED_API_KEY=

FMP_API_KEY=
EODHD_API_TOKEN=

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

TWELVEDATA_API_KEYS=

# NLP providers: zai (default, GLM-5.3 via Anthropic Messages), openai,
# anthropic, or custom (OpenAI-compatible endpoint by default).
# Leave provider-specific values blank when using a built-in default.
NLP_PROVIDER=zai
NLP_BASE_URL=
NLP_MODEL=
NLP_API_KEY=
# Used only by NLP_PROVIDER=custom. Supported formats: openai, anthropic.
NLP_FORMAT=openai

# Provider-specific keys are optional alternatives to NLP_API_KEY.
ZAI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# LME.com session cookie for the free T+3 daily off-warrant stock reports.
# Log in at lme.com, export cookies (Cookie-Editor extension -> Export -> JSON),
# then combine the values as "name1=value1; name2=value2" (ASP.NET_SessionId
# and .AspNet.Cookies are the ones that matter). Refresh when it expires —
# the harvest logs a visible fetch_log ERROR when the cookie dies.
LME_COOKIE=

# Proxy for Yahoo calls only (Yahoo 429s datacenter IPs). docker-compose sets
# socks5h://warp:9091 for the daemon; leave blank for direct.
ARKWATCH_YAHOO_PROXY=

# --- Docker / Easypanel deploy (see README "Deployment") ---
# Required by the api service (bearer key for /v1/*).
ARKWATCH_API_KEY=
# Set by the image (ARKWATCH_DATA_DIR=/data); override only for local runs.
# ARKWATCH_DATA_DIR=
# Build arg stamped into the daemon start log line (image has no git).
GIT_SHA=
# Optional Litestream offsite replica (Cloudflare R2), profile "litestream".
LITESTREAM_R2_ENDPOINT=
LITESTREAM_R2_BUCKET=
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=
