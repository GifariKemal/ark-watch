FRED_API_KEY=

FMP_API_KEY=
EODHD_API_TOKEN=

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional news/alert channels (all degrade to SKIPPED when blank).
CRYPTOPANIC_API_KEY=
DISCORD_WEBHOOK_URL=
# Self-hosted Argus MCP news source (market_news). Bearer token only; URL defaults to
# https://argus.gifariksuryo.xyz/mcp. Blank token = SKIPPED.
ARGUS_URL=
ARGUS_TOKEN=

# GDELT is a raw research archive nothing in ark-watch reads (~1.5 GB/day, it also bloats
# backups/replication). 0 = do not collect. Default 1 keeps upstream behaviour.
GDELT_ENABLED=1

# NLP providers: zai (default, GLM-5.3 via Anthropic Messages), openai,
# anthropic, or custom (OpenAI-compatible endpoint by default).
# Leave provider-specific values blank when using a built-in default.
NLP_PROVIDER=zai
NLP_BASE_URL=
NLP_MODEL=
NLP_API_KEY=
# Used only by NLP_PROVIDER=custom. Supported formats: openai, anthropic.
NLP_FORMAT=openai

# Free LLM without a paid key (docker-compose `ofm` service, see README): point custom at it and
# list fallback models (comma separated, tried in order; free lanes 502/429 at random).
#   NLP_PROVIDER=custom
#   NLP_BASE_URL=http://ofm:18901/v1
#   NLP_MODEL=openrouter/free,kilo-auto/free
#   NLP_FORMAT=openai
#   NLP_API_KEY=<forwardKey from the ofm volume: /data/settings.json>

# Provider-specific keys are optional alternatives to NLP_API_KEY.
ZAI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# LME.com session cookie for the free T+3 daily off-warrant stock reports.
# Log in at lme.com, export cookies (Cookie-Editor extension -> Export -> JSON),
# then combine the values as "name1=value1; name2=value2" (ASP.NET_SessionId
# and .AspNet.Cookies are the ones that matter). Refresh when it expires —
# the harvest logs a visible fetch_log ERROR when the cookie dies.
LME_COOKIE=

# Egress proxy for hosts that block datacenter IPs (Yahoo 429, CFTC 403). docker-compose sets
# socks5h://warp:9091 for the daemon; leave blank for direct.
ARKWATCH_PROXY=
# Hosts routed through it (comma list; subdomains match). CME/FRED must stay direct.
# ARKWATCH_PROXY_HOSTS=finance.yahoo.com,publicreporting.cftc.gov

# --- Docker / Easypanel deploy (see README "Deployment") ---
# Required by the api service (bearer key for /v1/*).
ARKWATCH_API_KEY=
# Set by the image (ARKWATCH_DATA_DIR=/data); override only for local runs.
# ARKWATCH_DATA_DIR=
# Build arg stamped into the daemon start log line (image has no git).
GIT_SHA=
# Optional Litestream offsite replica (Cloudflare R2), profile "litestream".
LITESTREAM_R2_ENDPOINT=
LITESTREAM_R2_BUCKET=
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=
